#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored.

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// Host running the Python dashboard server. Use a LAN IP, not a hostname,
// unless your network has working mDNS on the R4.
#define SERVER_HOST   "192.168.1.100"
// Must match the server's PORT (default 5000; use 5002 on macOS — see server/.env).
#define SERVER_PORT   5000

#endif
