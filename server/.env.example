# Copy to server/.env and fill in.
# Get a free key at https://api.nasa.gov — 1000 req/hr.
NASA_API_KEY=DEMO_KEY

# Anthropic API key for the daily sidebar insight.
# Get one at https://console.anthropic.com — usage is ~$0.001/day at Haiku rates.
# If unset, the sidebar falls back to Wikipedia "On This Day".
ANTHROPIC_API_KEY=

# Port the server listens on. Default is 5000. On macOS, port 5000 is taken by
# the AirPlay Receiver (System Settings → General → AirDrop & Handoff), so
# uncomment this to use 5002 instead. Keep SERVER_PORT in firmware secrets.h in sync.
# PORT=5002
